# لوکال — با npm run start:dev بارگذاری می‌شود (NODE_ENV=development)
# این فایل در گیت commit می‌شود. رازها فقط در .env بماند.

API_URL=http://localhost:3000
FRONTEND_APP_URL=http://localhost:4200
PAYMENT_RETURN_URL=http://localhost:4200/payment-result
FRONTEND_ORIGINS=http://localhost:4200

ACTIVE_PAYMENT_GATEWAY=zibal
ZIBAL_MERCHANT=zibal
ZIBAL_REQUEST_URL=https://gateway.zibal.ir/v1/request
ZIBAL_START_PAY_URL=https://gateway.zibal.ir/start

# Callback بعد از پرداخت — باید با آدرسی که سرور Nest روی آن گوش می‌دهد یکی باشد.
# زیبال معمولاً فقط HTTPS عمومی قبول می‌کند؛ اگر لوکال خطا داد، ngrok بزن و در .env.development.local بگذار:
# ZIBAL_CALLBACK_URL=https://xxxx.ngrok-free.app/api/v1/payments/callback/zibal
ZIBAL_CALLBACK_URL=http://localhost:3000/api/v1/payments/callback/zibal

PORT=3000
WEB_PUSH_VAPID_SUBJECT=mailto:support@tabagheh.com
