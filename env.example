# ======================
# App
# ======================
NODE_ENV=development
PORT=3000

# ======================
# Database
# ======================
DATABASE_URL=postgresql://user:password@localhost:5432/tabaghe

# اگر در سرور/CI بعد از هر npm install نمی‌خواهید prisma generate خودکار @prisma/client اجرا شود:
# PRISMA_SKIP_POSTINSTALL_GENERATE=true
# (کلاینت را یک‌بار در بیلد ایمیج یا لوکال با npm run db:generate بسازید.)

# در پروداکشن برای کاهش تأخیر اتصال، از pooler (مثل PgBouncer روی پورت 6432) یا
# پارامتر connection_limit روی URL پستگرس استفاده کنید؛ در چند نمونهٔ API
# باید همه به یک pooler اشاره کنند.
# PRISMA_CONNECTION_LIMIT=10

# ======================
# Redis (cache + throttler + Socket.io)
# ======================
# Optional in single-instance; recommended for multi-replica.
# Omit to use in-process Map for cache/throttle.
# Docker compose default: redis://tabagheh-redis:6379
# REDIS_URL=redis://localhost:6379
# TLS: rediss://user:pass@host:6380

# ======================
# Auth
# ======================
JWT_SECRET=super-secret-access
JWT_REFRESH_SECRET=super-secret-refresh

# Production: set GODADMIN_BOOTSTRAP_PASSWORD (never commit real value)
# GODADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_PASSWORD=

# ======================
# SMS Web OTP (Android autofill)
# ======================
# sms.ir template 591069 — last line: @tabagheh.com #CONTACTS
SMS_OTP_TEMPLATE_ID=591069
SMS_OTP_CODE_PARAMETER_NAME=CONTACTS
SMS_WEB_OTP_ORIGIN=tabagheh.com

# ======================
# Seller landing (/seller)
# ======================
# Dev: auto-seed on boot. Prod: use POST /admin/landing-pages/seed-seller or npm run seed:seller-landing
# SELLER_LANDING_AUTO_SEED=true
# SELLER_LANDING_FORCE_SEED=false

# ======================
# CORS
# ======================
FRONTEND_APP_URL=http://localhost:4200
FRONTEND_ORIGINS=http://localhost:4200

# ======================
# PDF گواهی کارشناسی (Puppeteer)
# ======================
# لینوکس/Docker (پیش‌فرض در Dockerfile): /usr/bin/chromium
# ویندوز توسعه محلی:
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# ======================
# Optional (Future)
# ======================
# SENTRY_DSN=

# ======================
# FX ingest (n8n)
# ======================
# Shared secret for POST /api/v1/integrations/fx-rates
# Header: X-Fx-Ingest-Key or Authorization: Bearer
# Also settable from Admin → Secrets as FX_INGEST_SECRET
# FX_INGEST_SECRET=change-me-to-a-long-random-string
