generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////
/// ENUMS
////////////////////

enum UserRole {
  USER
  ADMIN
}

enum ListingType {
  DIRECT
  EXCHANGE
  AUCTION
}

enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DELETED_BY_USER
}

enum ItemCondition {
  NEW
  USED
}

enum QuotaReason {
  FREE_DIRECT
  PLAN
}

enum QuotaAction {
  RESERVE
  COMMIT
  RELEASE
}
////////////////////
/// USER
////////////////////

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  email         String?  @unique
  passwordHash  String
  role          UserRole @default(USER)

  listings      Listing[]
  wallet        Wallet?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  planPurchases UserPlanPurchase[]
  quotaLedger   QuotaLedger[]
}

////////////////////
/// WALLET (LEDGER-BASED)
////////////////////

model Wallet {
  id                String   @id @default(cuid())
  userId            String   @unique
  balanceAvailable  Decimal  @default(0)
  balanceBlocked    Decimal  @default(0)

  user              User     @relation(fields: [userId], references: [id])
  transactions      WalletTransaction[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum WalletTransactionType {
  DEPOSIT
  BLOCK
  UNBLOCK
  SETTLEMENT
  PENALTY
  WITHDRAW_REQUEST
  WITHDRAW_PAID
}

enum WalletTransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

model WalletTransaction {
  id         String                  @id @default(cuid())
  walletId  String
  type       WalletTransactionType
  amount     Decimal
  status     WalletTransactionStatus
  meta       Json?
  createdAt  DateTime                @default(now())

  wallet     Wallet @relation(fields: [walletId], references: [id])
}

////////////////////
/// LISTING (CORE)
////////////////////

model Listing {
  id            String        @id @default(cuid())

  authorId      String
  author        User          @relation(fields: [authorId], references: [id])

  type          ListingType
  status        ListingStatus @default(PENDING)

  title         String
  categoryId    String

  gallery       String[]      @default([])
  thumbnail     String?

  condition     ItemCondition
  description   String

  province      String
  city          String

  rejectionReason String?
  deleteReason    String?

  approvedAt    DateTime?
  rejectedAt    DateTime?
  deletedAt     DateTime?

  direct        ListingDirect?
  exchange      ListingExchange?
  auction       ListingAuction?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  quotaLedger   QuotaLedger[]

  @@index([status, type])
  @@index([authorId])
}

////////////////////
/// DIRECT SALE
////////////////////

model ListingDirect {
  listingId       String   @id
  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  price           Decimal
  shippingMethods String[]
}

////////////////////
/// EXCHANGE
////////////////////

model ListingExchange {
  listingId            String   @id
  listing              Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  desiredCategoryId    String
  desiredTitle         String
  desiredDescription   String?

  ownValue             Decimal
  extraPaymentAmount   Decimal  @default(0)

  acceptOtherItems     Boolean  @default(false)
  allowDirectSale      Boolean  @default(false)
  directPrice          Decimal?
}

////////////////////
/// AUCTION
////////////////////

model ListingAuction {
  listingId        String   @id
  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  basePrice        Decimal
  minBidIncrement  Decimal

  endDatetime      DateTime

  buyNowEnabled    Boolean  @default(false)
  buyNowPrice      Decimal?
}
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
model Plan {
  id          String     @id @default(cuid())
  title       String
  description String?
  price       Int        @default(0) // فعلاً (فاز Payment کامل می‌شود)
  isActive    Boolean    @default(true)

  rules       PlanRule[]
  purchases   UserPlanPurchase[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model PlanRule {
  id       String      @id @default(cuid())
  planId   String
  plan     Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)

  type     ListingType
  count    Int

  @@unique([planId, type])
}
model UserPlanPurchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  planId    String
  plan      Plan     @relation(fields: [planId], references: [id])

  status    String   @default("ACTIVE")

  quotaLedger QuotaLedger[]

  createdAt DateTime @default(now())
}




model QuotaLedger {
  id          String      @id @default(cuid())

  userId      String
  user        User        @relation(fields: [userId], references: [id])

  listingId   String?
  listing     Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)

  listingType ListingType

  action      QuotaAction   // RESERVE | COMMIT | RELEASE
  reason      QuotaReason   // FREE_DIRECT | PLAN

  // اگر از پلن مصرف شده
  planPurchaseId String?
  planPurchase   UserPlanPurchase? @relation(fields: [planPurchaseId], references: [id], onDelete: SetNull)

  note        String?

  createdAt   DateTime    @default(now())

  @@index([userId, listingType])
  @@index([listingId])
}
