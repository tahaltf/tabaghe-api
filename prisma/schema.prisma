generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////
/// ENUMS
////////////////////

enum UserRole {
  USER
  ADMIN
}

enum ListingType {
  DIRECT
  EXCHANGE
  AUCTION
}

enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DELETED_BY_USER
}

enum ItemCondition {
  NEW
  USED
}

////////////////////
/// USER
////////////////////

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  email         String?  @unique
  passwordHash  String
  role          UserRole @default(USER)

  listings      Listing[]
  wallet        Wallet?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

////////////////////
/// WALLET (LEDGER-BASED)
////////////////////

model Wallet {
  id                String   @id @default(cuid())
  userId            String   @unique
  balanceAvailable  Decimal  @default(0)
  balanceBlocked    Decimal  @default(0)

  user              User     @relation(fields: [userId], references: [id])
  transactions      WalletTransaction[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum WalletTransactionType {
  DEPOSIT
  BLOCK
  UNBLOCK
  SETTLEMENT
  PENALTY
  WITHDRAW_REQUEST
  WITHDRAW_PAID
}

enum WalletTransactionStatus {
  PENDING
  CONFIRMED
  FAILED
}

model WalletTransaction {
  id         String                  @id @default(cuid())
  walletId  String
  type       WalletTransactionType
  amount     Decimal
  status     WalletTransactionStatus
  meta       Json?
  createdAt  DateTime                @default(now())

  wallet     Wallet @relation(fields: [walletId], references: [id])
}

////////////////////
/// LISTING (CORE)
////////////////////

model Listing {
  id            String        @id @default(cuid())

  authorId      String
  author        User          @relation(fields: [authorId], references: [id])

  type          ListingType
  status        ListingStatus @default(PENDING)

  title         String
  categoryId    String

  gallery       String[]      @default([])
  thumbnail     String?

  condition     ItemCondition
  description   String

  province      String
  city          String

  rejectionReason String?
  deleteReason    String?

  approvedAt    DateTime?
  rejectedAt    DateTime?
  deletedAt     DateTime?

  direct        ListingDirect?
  exchange      ListingExchange?
  auction       ListingAuction?

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, type])
  @@index([authorId])
}

////////////////////
/// DIRECT SALE
////////////////////

model ListingDirect {
  listingId       String   @id
  listing         Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  price           Decimal
  shippingMethods String[]
}

////////////////////
/// EXCHANGE
////////////////////

model ListingExchange {
  listingId            String   @id
  listing              Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  desiredCategoryId    String
  desiredTitle         String
  desiredDescription   String?

  ownValue             Decimal
  extraPaymentAmount   Decimal  @default(0)

  acceptOtherItems     Boolean  @default(false)
  allowDirectSale      Boolean  @default(false)
  directPrice          Decimal?
}

////////////////////
/// AUCTION
////////////////////

model ListingAuction {
  listingId        String   @id
  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  basePrice        Decimal
  minBidIncrement  Decimal

  endDatetime      DateTime

  buyNowEnabled    Boolean  @default(false)
  buyNowPrice      Decimal?
}
