generator client {
  provider = "prisma-client-js"
}

// منبع حقیقت مدل داده: همین فایل + پوشهٔ prisma/migrations.
// — هم‌خوانی دیتابیس با اسکیما: فقط `npx prisma migrate deploy` (SQL اجرا می‌کند؛ Prisma Client را دوباره نمی‌سازد).
// — به‌روز کردن TypeScript client بعد از تغییر schema.prisma: دستی `npx prisma generate` (یا بیلد Docker/CI).
// — از `prisma db pull` / `db push` برای «سینک روزمره» در پروداکشن استفاده نکنید؛ اسکیما را با migration نگه دارید.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////
/// ENUMS
////////////////////

enum UserRole {
  USER
  ADMIN
  GODADMIN
}

enum UserStatus {
  INCOMPLETE
  PENDING
  APPROVED
  REJECTED
}

enum BankAccountVerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingType {
  DIRECT
  EXCHANGE
  AUCTION
}

enum ListingStatus {
  DRAFT     // پیش‌نویس فروشنده — بدون صف ادمین
  PENDING   // در انتظار تایید ادمین
  APPROVED  // منتشر شده
  REJECTED  // رد شده
  SOLD      // فروخته شده
  ARCHIVED  // آرشیو شده (حذف موقت)
  DELETED_BY_USER   // حذف شده توسط کاربر
}

enum ListingImportSource {
  MANUAL
  WORDPRESS
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID

  // --- مراحل لجستیک متمرکز (Hub) ---
  AWAITING_SHIPMENT_TO_HUB
  SHIPPED_TO_HUB           // 👈 این خط باید حتماً اضافه بشه (ارسال شده به سمت هاب)
  RECEIVED_AT_HUB
  CHECKING_AT_HUB
  VERIFIED_AT_HUB
  REJECTED_AT_HUB
  SHIPPED_TO_BUYER
  // ----------------------------------

  SHIPPED
  DELIVERED
  RETURN_REQUESTED
  RETURN_SHIPPED
  COMPLETED
  DISPUTED
  CANCELLED
}

enum ExchangePayer {
  ME          // من (صاحب آگهی) مابه‌التفاوت را می‌دهم
  BUYER       // خریدار (پیشنهاد دهنده) باید مابه‌التفاوت را بدهد
  NONE        // معاوضه سر به سر (بدون رد و بدل پول)
}
enum PaymentMethod {
  GATEWAY
  WALLET
}
enum ItemCondition {
  NEW
  USED
}

enum ShippingPayer {
  SELLER_PREPAID
  BUYER_PREPAID
  BUYER_POSTPAID
}

enum QuotaReason {
  FREE_DIRECT
  FREE_EXCHANGE
  PLAN
}

enum QuotaAction {
  RESERVE
  COMMIT
  RELEASE
}

enum WalletTransactionType {
  DEPOSIT
  BLOCK
  UNBLOCK
  SETTLEMENT       // واریز وجه سفارش به فروشنده
  COMMISSION_FEE   // کسر کارمزد پلتفرم
  PENALTY
  WITHDRAW_REQUEST
  WITHDRAW_PAID
  REFUND           // برگشت وجه به خریدار در صورت لغو یا حل اختلاف
  REFERRAL_REWARD  // پاداش معرف از کارمزد فروش دعوت‌شده
  AI_TOKEN_PURCHASE // خرید توکن تولید محتوا از کیف پول
}

enum AiTokenLedgerAction {
  GRANT_KYC_WELCOME
  GRANT_PLAN
  PURCHASE
  RESERVE
  COMMIT
  RELEASE
  EXPIRE_PLAN
  ADMIN_ADJUST
}

enum AiTokenBucket {
  PLAN
  PURCHASED
}

enum AiContentType {
  STORY
  POST
  CAPTION
}

enum AiContentRequestStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AuctionStatus {
  ACTIVE
  FINISHED
}

enum AuctionSettlementStatus {
  PENDING
  PAID
  FAILED
  PENALIZED
}

enum AuctionBidStatus {
  ACTIVE
  OUTBID
  WON
  LOST
  CANCELLED
}

enum SecondChanceOfferStatus {
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum ExchangeOfferStatus {
  PENDING
  WAITLISTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum PurchaseOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum NotificationType {
  AUCTION_WON
  AUCTION_LOST
  AUCTION_PAYMENT_REMINDER
  ACTION_DEADLINE_REMINDER
  AUCTION_PENALIZED
  BUY_NOW
  EXCHANGE_OFFER_RECEIVED
  EXCHANGE_OFFER_ACCEPTED
  EXCHANGE_OFFER_REJECTED
  PURCHASE_OFFER_RECEIVED
  PURCHASE_OFFER_ACCEPTED
  PURCHASE_OFFER_REJECTED
  ADMIN_ANNOUNCEMENT
  ORDER_STATUS_CHANGED
  KYC_APPROVED
  KYC_REJECTED
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_EXPIRY_REMINDER
  LISTING_EXPIRED
  REPAIR_STATUS_CHANGED
  TICKET_REPLY
  SYSTEM
  ADMIN_ALERT_NEW_TICKET
  ADMIN_ALERT_NEW_LISTING
  ADMIN_ALERT_NEW_USER
  ADMIN_ALERT_CONTACT_MESSAGE
  ADMIN_ALERT_NEW_REPAIR
  ADMIN_ALERT_NEW_PRODUCT_REQUEST
  ADMIN_ALERT_TICKET_USER_MESSAGE
  WALLET_DEPOSIT_SUBMITTED
  WALLET_DEPOSIT_APPROVED
  WALLET_DEPOSIT_REJECTED
  WALLET_WITHDRAW_SUBMITTED
  WALLET_WITHDRAW_APPROVED
  WALLET_WITHDRAW_REJECTED
  WALLET_TOPUP
  WALLET_REFUND
  ADMIN_ALERT_WALLET_DEPOSIT
  ADMIN_ALERT_WALLET_WITHDRAW
  ADMIN_ALERT_KYC_SUBMISSION
  ADMIN_ALERT_NEW_ORDER
  POST_PURCHASE_SURVEY
  PLAN_CHANGED
  PLAN_EXPIRED
}

enum SurveyRole {
  BUYER
  SELLER
}

enum RepairRequestStatus {
  PENDING_REVIEW           // ثبت اولیه، منتظر بررسی ادمین
  REJECTED                 // رد شده (با دلیل)
  APPROVED                 // تایید شده، منتظر انتخاب زمان توسط کاربر
  DELIVERY_TIME_SELECTED   // کاربر زمان را انتخاب کرد، منتظر ارسال کالا
  AWAITING_DELIVERY        // کاربر کالا را ارسال کرد (کد رهگیری + ویدیو)
  RECEIVED_AT_HUB          // کالا به هاب طبقه رسید
  UNDER_INSPECTION         // در حال بررسی/کارشناسی
  RESULT_READY             // نتیجه آماده، منتظر تایید هزینه توسط کاربر
  IN_PROGRESS              // در حال تعمیر
  READY_TO_SHIP            // تعمیر کامل شد، آماده ارسال برگشتی
  SHIPPED_BACK             // ارسال شد به کاربر (کد رهگیری + ویدیو)
  COMPLETED                // به دست کاربر رسید / فرآیند کامل شد
  CANCELLED                // لغو شده
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum ProductRequestStatus {
  PENDING
}

enum ProductRequestCondition {
  NEW
  USED
  ANY
}

enum OtpPurpose {
  LOGIN
  REGISTER
  ADMIN_LOGIN
  WITHDRAW
}

enum LocationType {
  PROVINCE
  CITY
}

enum OrderType {
  DIRECT
  AUCTION
  EXCHANGE
}


////////////////////
/// USER & PROFILE
////////////////////

model User {
  id                  String         @id @default(cuid())
  phone               String         @unique
  email               String?        @unique
  passwordHash        String?
  savedListings       SavedListing[]

  // 👈 فیلد جدید تایید قوانین
  termsAcceptedAt     DateTime?
  termsAcceptedVersion String?
  sellerTermsAcceptedAt DateTime?
  sellerTermsAcceptedVersion String?

  firstName           String?
  lastName            String?
  fatherName          String?
  /** پاسخ خام استعلام هویت (شاهکار + ثبت‌احوال)؛ در فرم کاربر نمایش داده نمی‌شود */
  identityInquiry     Json?
  displayName         String?
  nationalCode        String?        @unique
  nationalCardImage   String?
  status              UserStatus     @default(INCOMPLETE)
  role                UserRole       @default(USER)
  isActive            Boolean        @default(true)
  telegramId          String?        @unique
  telegramToken       String?        @unique

  birthDate           DateTime?

  buyerOrders         Order[]        @relation("BuyerOrders")
  sellerOrders        Order[]        @relation("SellerOrders")

  buyerConversations  Conversation[] @relation("BuyerConversations")
  sellerConversations Conversation[] @relation("SellerConversations")
  messagesSent        Message[]

  avatar              String?
  bio                 String?
  notifyEmail         Boolean        @default(true)
  notifySms           Boolean        @default(true)
  notifyPush          Boolean        @default(true)
  lastLoginAt         DateTime?

  givenReviews        Review[]       @relation("GivenReviews")
  receivedReviews     Review[]       @relation("ReceivedReviews")
  postPurchaseSurveys PostPurchaseSurvey[]

  shabaNumber         String?
  bankCardNumber      String?
  bankCardBin         String?
  bankName            String?
  financialVerifiedAt DateTime?
  kycRejectionReason  String?
  kycReviewedAt       DateTime?
  listings            Listing[]
  wallet              Wallet?
  planPurchases       UserPlanPurchase[]
  quotaLedger         QuotaLedger[]
  notifications       Notification[]
  exchangeOffers      ExchangeOffer[]
  purchaseOffers      PurchaseOffer[]
  bids                AuctionBid[]
  secondChanceOffers  SecondChanceOffer[]
  addresses           Address[]

  highestBids         ListingAuction[] @relation("HighestBidder")
  secondBids          ListingAuction[] @relation("SecondBidder")
  thirdBids           ListingAuction[] @relation("ThirdBidder")

  isVerified          Boolean          @default(false)
  /** کاربر مورد تایید ادمین — روی آگهی‌های او نشان «مورد تایید» نمایش داده می‌شود */
  isApproved          Boolean          @default(false)
  rating              Float            @default(5)
  reviewCount         Int              @default(0)
  isOnline            Boolean          @default(false)
  trustScore          Int              @default(100)

  repairRequests      RepairRequest[]
  productRequests     ProductRequest[]
  tickets             Ticket[]
  ratingHistory       UserRatingHistory[]
  campaignLinks       CampaignLink[]
  landingPages        LandingPage[]
  wordpressApiTokens  WordPressApiToken[]
  wordpressConnection WordPressConnection?
  marketingAccounts   MarketingAccount[]
  marketingMediaAssets MarketingMediaAsset[]
  marketingPosts      MarketingPost[]
  marketingMessagesSent MarketingMessage[]
  cart                Cart?
  listingViews        ListingView[]
  couponRedemptions   CouponRedemption[]
  sellerCoupons       Coupon[]         @relation("SellerCoupons")
  checkoutSessions    CheckoutSession[]
  loginLogs           UserLoginLog[]
  paymentInitLogs     PaymentInitLog[]
  zohalInquiryLogs    ZohalInquiryLog[]
  inquiryRestriction  UserInquiryRestriction?
  bankAccounts        UserBankAccount[]

  /** اسلاگ یکتای ویترین فروشگاه عمومی (/seller/:shopSlug) */
  shopSlug            String?        @unique
  /** کد دعوت یکتای کاربر برای معرفی دوستان */
  inviteCode          String?        @unique
  /** درصد پاداش دعوت اختصاصی (null = پیش‌فرض سراسری REFERRAL_COMMISSION_PERCENT) */
  referralCommissionPercent Float?
  /** معرف مستقیم — فقط یک‌بار قابل تنظیم */
  referredById        String?
  referredBy          User?          @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals           User[]         @relation("UserReferrals")
  referralRewardsAsReferrer ReferralReward[] @relation("ReferralRewardReferrer")
  referralRewardsAsSeller   ReferralReward[] @relation("ReferralRewardSeller")
  categoryFees        UserCategoryFee[]
  aiTokenBalance      AiTokenBalance?
  aiTokenLedger       AiTokenLedger[]
  aiContentRequests   AiContentRequest[]
  listingMergeRequests ListingMergeRequest[] @relation("MergeRequestRequester")
  listingMergeReviews  ListingMergeRequest[] @relation("MergeRequestReviewer")

  /** نقش سفارشی پنل ادمین — فقط برای role=ADMIN معنا دارد */
  adminRoleId         String?
  adminRole           AdminRole?     @relation(fields: [adminRoleId], references: [id], onDelete: SetNull)

  /** دسترسی‌های پنل کاربر — null یا کلید ناموجود = فعال؛ فقط false صریح غیرفعال می‌کند */
  panelAccess         Json?

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([referredById])
  @@index([adminRoleId])
}

////////////////////
/// ADMIN RBAC
////////////////////

model AdminRole {
  id          String                @id @default(cuid())
  name        String
  slug        String                @unique
  description String?
  isSystem    Boolean               @default(false)
  isActive    Boolean               @default(true)
  permissions AdminRolePermission[]
  users       User[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

model AdminPermission {
  id          String                @id @default(cuid())
  key         String                @unique
  group       String
  groupLabel  String
  action      String
  label       String
  description String?
  sortOrder   Int                   @default(0)
  roles       AdminRolePermission[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([group])
}

model AdminRolePermission {
  roleId       String
  permissionId String
  role         AdminRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   AdminPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

enum UserLoginMethod {
  OTP
  ADMIN_OTP
}

/** لاگ ورود موفق به سامانه — برای بررسی امنیتی / کلاهبرداری */
model UserLoginLog {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  method    UserLoginMethod
  ipAddress String?
  userAgent String?
  createdAt DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
}

enum PaymentInitKind {
  ORDER
  WALLET_TOPUP
  REPAIR
  CHECKOUT_SESSION
  CHECKOUT_WALLET
}

/** ثبت هر شروع پرداخت (درگاه یا کیف پول) همراه IP برای ممیزی */
model PaymentInitLog {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind          PaymentInitKind
  paymentSource String          @default("GATEWAY")
  amount        Decimal?
  referenceId   String?
  authority     String?
  gateway       String?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime        @default(now())

  @@index([userId, createdAt])
  @@index([authority])
  @@index([referenceId, kind])
  @@index([ipAddress, createdAt])
}

model ZohalInquiryLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// نام سرویس: "shahkar" | "national_identity" | "postal_code" | "card_match"
  service     String
  /// SHA-256 hex از payload نرمال‌شده (بدون اطلاعات حساس در لاگ جداگانه)
  payloadHash String
  success     Boolean
  /// errorCode از Zohal یا "BAD_REQUEST" / "BAD_GATEWAY" برای طبقه‌بندی
  errorCode   String?
  /// پاسخ خام برای گزارش‌گیری و بررسی مناقشات با سرویس‌دهنده
  responseRaw Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([userId, service, payloadHash])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model PostalCodeCache {
  postalCode  String   @id
  province    String
  city        String
  district    String?
  fullAddress String
  responseRaw Json?
  success     Boolean
  errorCode   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// کش سراسری تبدیل کارت → شبا (بدون userId؛ مثل PostalCodeCache)
model CardToIbanCache {
  cardNumber   String   @id
  shabaNumber  String?
  success      Boolean
  errorCode    String?
  responseRaw  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// کش سراسری تطبیق مالکیت کارت با کد ملی (کلید = hash payload)
model CardOwnerMatchCache {
  cacheKey     String   @id
  cardNumber   String
  nationalCode String
  birthDate    String
  matched      Boolean  @default(false)
  success      Boolean
  errorCode    String?
  responseRaw  Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cardNumber])
}

model UserInquiryRestriction {
  userId                   String   @id
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  identityPayloadAttempts  Int      @default(0)
  identityFailureCount     Int      @default(0)
  financialPayloadAttempts Int      @default(0)
  financialFailureCount    Int      @default(0)
  inquiryBlocked           Boolean  @default(false)
  manualEntryOnly          Boolean  @default(false)
  maxInquiriesPerMinute    Int?
  maxInquiriesPerDay       Int?
  maxBankAccounts          Int?
  blockedReason            String?
  blockedAt                DateTime?
  unblockedByAdminId       String?
  updatedAt                DateTime @updatedAt
}

model UserBankAccount {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  label          String?
  bankCardNumber String?
  bankCardBin    String?
  bankName       String?
  shabaNumber    String?
  isDefault      Boolean   @default(false)
  verificationStatus BankAccountVerificationStatus @default(PENDING)
  rejectionReason String?
  reviewedAt     DateTime?
  reviewedByAdminId String?
  verifiedAt     DateTime?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
  @@index([userId, deletedAt])
  @@index([userId, bankCardNumber])
}

model UserRatingHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  previous  Float
  next      Float
  delta     Float
  reason    String
  source    String
  orderId   String?
  listingId String?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Address {
  id          String   @id @default(cuid())
  title       String
  province    String
  city        String
  fullAddress String
  postalCode  String
  phone       String
  /** آدرس از استعلام کد پستی آمده؛ استان/شهر/آدرس/کدپستی دیگر قابل ویرایش نیست */
  fromInquiry Boolean  @default(false)

  userId      String
  user        User     @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
}

////////////////////
/// AUTH & OTP
////////////////////

model OtpCode {
  id        String     @id @default(cuid())
  phone     String
  code      String
  purpose   OtpPurpose @default(LOGIN)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([phone])
}

////////////////////
/// WALLET
////////////////////

model Wallet {
  id               String              @id @default(cuid())
  userId           String              @unique
  balanceAvailable Decimal             @default(0)
  balanceBlocked   Decimal             @default(0)
  balanceCredit    Decimal             @default(0)
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     WalletTransaction[]

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model WalletTransaction {
  id          String                  @id @default(cuid())
  walletId    String
  wallet      Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        WalletTransactionType
  amount      Decimal
  status      WalletTransactionStatus
  referenceId String?
  meta        Json?
  createdAt   DateTime                @default(now())
}

////////////////////
/// LISTING
////////////////////

model Listing {
  id              String         @id @default(cuid())
  authorId        String
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  type            ListingType
  orders          Order[]

  // 👈 فیلد جدید تنظیمات معاوضه
  exchangePayer   ExchangePayer? @default(NONE)

  status          ListingStatus  @default(PENDING)
  savedBy         SavedListing[]
  title           String
  conversations   Conversation[]

  categoryId      String
  category        Category       @relation(fields: [categoryId], references: [id])

  gallery         String[]       @default([])
  thumbnail       String?
  condition       ItemCondition
  description     String

  provinceId      String
  province        Location       @relation("ProvinceListings", fields: [provinceId], references: [id])
  cityId          String
  city            Location       @relation("CityListings", fields: [cityId], references: [id])

  shippingPayer   ShippingPayer  @default(BUYER_PREPAID)
  /** null = هزینه ارسال پیش‌فرض سایت (SHIPPING_COST) */
  shippingCostOverride Int?
  /** موجودی قابل فروش؛ پیش‌فرض ۱ */
  stockQuantity   Int            @default(1)
  /** فقط فروش تکی — حتی با موجودی بیشتر، خریدار فقط ۱ عدد می‌تواند بخرد */
  singleItemSale  Boolean        @default(true)

  rejectionReason String?
  deleteReason    String?
  approvedAt      DateTime?
  expiresAt       DateTime?   // پایان مدت نمایش روی سایت (از زمان تایید ادمین)
  expiryReminderSentAt DateTime?
  rejectedAt      DateTime?
  /** پس از رد آگهی یا ارسال مجدد؛ پیشنهادهای قدیمی‌تر از این زمان در UI نشان داده نمی‌شوند */
  exchangeOffersSince DateTime?
  deletedAt       DateTime?

  /** ویژه بودن آگهی: نمایش با استایل پرمیوم و بالاتر از بقیه */
  isFeatured      Boolean   @default(false)
  featuredAt      DateTime?

  sellerRequiresVerification Boolean @default(false)
  /** مهلت تست / گارانتی فروشنده به روز؛ null = بدون گارانتی */
  testPeriodDays  Int?

  importSource       ListingImportSource @default(MANUAL)
  externalProductId  String?
  externalSiteUrl    String?
  shortDescription   String?
  attributes         Json?

  direct          ListingDirect?
  exchange        ListingExchange?
  auction         ListingAuction?
  quotaLedger     QuotaLedger[]
  exchangeOffers  ExchangeOffer[]
  purchaseOffers  PurchaseOffer[]
  views           ListingView[]
  aiContentRequests AiContentRequest[]

  mergeGroupId    String?
  mergeGroup      ListingMergeGroup? @relation(fields: [mergeGroupId], references: [id], onDelete: SetNull)

  mergeRequestsAsSource ListingMergeRequest[] @relation("MergeRequestSource")
  mergeRequestsAsRequestedTarget ListingMergeRequest[] @relation("MergeRequestRequestedTarget")
  mergeRequestsAsFinalTarget ListingMergeRequest[] @relation("MergeRequestFinalTarget")

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status, type])
  @@index([status, categoryId, createdAt])
  @@index([status, type, createdAt])
  @@index([status, deletedAt, cityId])
  @@index([status, deletedAt, provinceId])
  @@index([status, isFeatured, featuredAt, createdAt])
  @@index([authorId])
  @@index([provinceId, cityId])
  @@index([createdAt])
  @@index([status, expiresAt])
  @@index([isFeatured, createdAt])
  @@index([importSource, status])
  @@index([mergeGroupId])
  @@unique([authorId, externalSiteUrl, externalProductId])
}

enum ListingMergeRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model ListingMergeGroup {
  id        String    @id @default(cuid())
  listings  Listing[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model ListingMergeRequest {
  id                       String                    @id @default(cuid())
  sourceListingId          String
  sourceListing            Listing                   @relation("MergeRequestSource", fields: [sourceListingId], references: [id], onDelete: Cascade)
  requestedTargetListingId String
  requestedTargetListing   Listing                   @relation("MergeRequestRequestedTarget", fields: [requestedTargetListingId], references: [id], onDelete: Cascade)
  finalTargetListingId     String?
  finalTargetListing       Listing?                  @relation("MergeRequestFinalTarget", fields: [finalTargetListingId], references: [id], onDelete: SetNull)
  requesterId              String
  requester                User                      @relation("MergeRequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  status                   ListingMergeRequestStatus @default(PENDING)
  adminNote                String?
  reviewedById             String?
  reviewedBy               User?                     @relation("MergeRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt               DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([status, createdAt])
  @@index([requesterId, createdAt])
  @@index([sourceListingId, status])
  @@index([requestedTargetListingId])
}

model ListingDirect {
  listingId       String   @id
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price           Decimal
  /** قیمت اصلی برای نمایش خط‌خورده هنگام تخفیف */
  compareAtPrice  Decimal?
  /** قیمت ویژه؛ اگر مقدار داشته باشد این قیمت مؤثر خرید است */
  salePrice       Decimal?
  allowExchange   Boolean  @default(false)
  shippingMethods String[]
}

model ListingExchange {
  listingId          String   @id
  listing            Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  desiredCategoryId  String
  desiredTitle       String
  desiredDescription String?
  ownValue           Decimal
  extraPaymentAmount Decimal  @default(0)
  acceptOtherItems   Boolean  @default(false)
  allowDirectSale    Boolean  @default(false)
  directPrice        Decimal?
}

model ListingAuction {
  listingId       String        @id
  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  basePrice       Decimal
  minBidIncrement Decimal
  endDatetime     DateTime
  buyNowEnabled   Boolean       @default(false)
  buyNowPrice     Decimal?
  status          AuctionStatus @default(ACTIVE)

  highestBidAmount Decimal?
  highestBidderId  String?
  highestBidder    User?         @relation("HighestBidder", fields: [highestBidderId], references: [id], onDelete: SetNull)

  secondBidderId   String?
  secondBidder     User?         @relation("SecondBidder", fields: [secondBidderId], references: [id], onDelete: SetNull)

  thirdBidderId    String?
  thirdBidder      User?         @relation("ThirdBidder", fields: [thirdBidderId], references: [id], onDelete: SetNull)

  bids             AuctionBid[]
  settlementStatus AuctionSettlementStatus @default(PENDING)
  paymentDeadline  DateTime?
  finishedAt       DateTime?
  secondChanceOffers SecondChanceOffer[]

  @@index([status, endDatetime])
}

model SecondChanceOffer {
  id        String                 @id @default(cuid())
  listingId String
  auction   ListingAuction         @relation(fields: [listingId], references: [listingId], onDelete: Cascade)

  userId    String
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amount    Decimal
  status    SecondChanceOfferStatus @default(OFFERED)
  expiresAt DateTime

  acceptedAt DateTime?
  declinedAt DateTime?
  expiredAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, createdAt])
  @@index([userId, createdAt])
  @@unique([listingId, userId, status])
}

model AuctionBid {
  id            String           @id @default(cuid())
  listingId     String
  auction       ListingAuction   @relation(fields: [listingId], references: [listingId], onDelete: Cascade)
  bidderId      String
  bidder        User             @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  amount        Decimal
  blockedAmount Decimal          @default(0)
  status        AuctionBidStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())

  @@index([listingId, createdAt])
  @@index([bidderId, createdAt])
}

model SavedListing {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id])

  @@unique([userId, listingId])
}

////////////////////
/// PLANS & QUOTA
////////////////////

model Plan {
  id          String             @id @default(cuid())
  title       String
  /// عنوان تبلیغاتی برای نمایش در سایت؛ اگر خالی باشد از title استفاده می‌شود
  marketingTitle String?
  description String?
  price       Int                @default(0)
  isActive    Boolean            @default(true)
  /// مدت اعتبار اشتراک پس از خرید (روز)، مثلاً ۳۶۵ = یک سال
  durationDays              Int @default(365)
  /// تخفیف از کارمزد محاسبه‌شده برای فروش مستقیم (۰ تا ۹۰ درصد)
  feeDiscountDirectPercent  Int @default(0)
  /// تخفیف از کارمزد محاسبه‌شده برای مزایده (۰ تا ۹۰ درصد)
  feeDiscountAuctionPercent Int @default(0)
  /// کف کارمزد نهایی فروش مستقیم پس از تخفیف پلن (تومان؛ ۰ = بدون کف)
  feeFloorDirect  Decimal @default(0) @db.Decimal(18, 0)
  /// سقف کارمزد نهایی فروش مستقیم پس از تخفیف پلن (تومان؛ ۰ = بدون سقف)
  feeCapDirect    Decimal @default(0) @db.Decimal(18, 0)
  /// کف کارمزد نهایی مزایده پس از تخفیف پلن (تومان؛ ۰ = بدون کف)
  feeFloorAuction Decimal @default(0) @db.Decimal(18, 0)
  /// سقف کارمزد نهایی مزایده پس از تخفیف پلن (تومان؛ ۰ = بدون سقف)
  feeCapAuction   Decimal @default(0) @db.Decimal(18, 0)
  /// برچسب روی کارت پلن (مثلاً «محبوب‌ترین»)
  badgeLabel String?
  /// رنگ برچسب (ترجیحاً هگز مثل #22c55e)
  badgeColor String?
  /// توکن تولید محتوا در هر دوره اشتراک (با تمدید reset می‌شود)
  aiTokensPerMonth Int @default(0)
  rules       PlanRule[]
  purchases   UserPlanPurchase[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model PlanRule {
  id     String      @id @default(cuid())
  planId String
  plan   Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  type   ListingType
  count  Int

  @@unique([planId, type])
}

model UserPlanPurchase {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan          @relation(fields: [planId], references: [id])
  status      String        @default("ACTIVE")
  /// پایان اعتبار اشتراک؛ برای خریدهای جدید از روی plan.durationDays ست می‌شود
  expiresAt   DateTime?
  /// زمان ارسال اعلان انقضا (جلوگیری از نوتیف تکراری)
  expiryNotifiedAt DateTime?
  quotaLedger QuotaLedger[]
  aiTokenLedger AiTokenLedger[]
  createdAt   DateTime      @default(now())

  @@index([status, expiresAt])
}

model QuotaLedger {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId      String?
  listing        Listing?          @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingType    ListingType
  action         QuotaAction
  reason         QuotaReason
  planPurchaseId String?
  planPurchase   UserPlanPurchase? @relation(fields: [planPurchaseId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime          @default(now())

  @@index([userId, listingType])
}

////////////////////
/// AI CONTENT STUDIO
////////////////////

model AiTokenBalance {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planTokens      Int      @default(0)
  purchasedTokens Int      @default(0)
  reservedTokens  Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model AiTokenLedger {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  action         AiTokenLedgerAction
  bucket         AiTokenBucket?
  amount         Int
  balanceAfter   Int?
  planPurchaseId String?
  planPurchase   UserPlanPurchase?   @relation(fields: [planPurchaseId], references: [id], onDelete: SetNull)
  walletTxId     String?
  requestId      String?
  request        AiContentRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([requestId])
}

model AiContentRequest {
  id              String                 @id @default(cuid())
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId       String
  listing         Listing                @relation(fields: [listingId], references: [id], onDelete: Cascade)
  type            AiContentType
  styleId         String?
  userPrompt      String?
  /// پرامپت نهایی ارسال‌شده برای ساخت تصویر (برای مانیتور ادمین)
  imagePrompt     String?
  status          AiContentRequestStatus @default(PENDING)
  resultImagePath String?
  resultCaption   String?
  tokensCharged   Int                    @default(0)
  provider        String?
  model           String?
  costUsd         Decimal?               @db.Decimal(10, 6)
  errorMessage    String?
  parentRequestId String?
  parentRequest   AiContentRequest?      @relation("AiContentRegenerate", fields: [parentRequestId], references: [id], onDelete: SetNull)
  childRequests   AiContentRequest[]     @relation("AiContentRegenerate")
  ledgerEntries   AiTokenLedger[]
  createdAt       DateTime               @default(now())
  completedAt     DateTime?

  @@index([userId, createdAt])
  @@index([listingId])
}

////////////////////
/// NOTIFICATION
////////////////////

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  meta      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

////////////////////
/// EXCHANGE
////////////////////

model ExchangeOffer {
  id           String              @id @default(cuid())
  listingId    String
  listing      Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  offererId    String
  offerer      User                @relation(fields: [offererId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  images       String[]
  extraPayment Decimal             @default(0)
  status       ExchangeOfferStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  isPayerMe    Boolean             @default(true)

  @@index([listingId, status])
  @@index([offererId])
}

////////////////////
/// PURCHASE OFFER (پیشنهاد خرید — فقط فروش مستقیم)
////////////////////

model PurchaseOffer {
  id                 String              @id @default(cuid())
  listingId          String
  listing            Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId            String
  buyer              User                @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  amount             Decimal
  description        String?
  /** استان پیشنهاددهنده (نام — مثل آدرس) */
  province           String?
  /** شهر پیشنهاددهنده (نام — مثل آدرس) */
  city               String?
  status             PurchaseOfferStatus @default(PENDING)
  rejectionReason    String?
  expiresAt          DateTime
  acceptedAt         DateTime?
  reservedUntil      DateTime?
  /** اسنپ‌شات قیمت ویژه قبل از تأیید (برای restore) */
  prevSalePrice      Decimal?
  prevCompareAtPrice Decimal?
  cartItem           CartItem?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([listingId, status])
  @@index([buyerId, listingId])
  @@index([expiresAt])
  @@index([reservedUntil, status])
}

////////////////////
/// REPAIR & TICKET
////////////////////

model RepairRequest {
  id                   String              @id @default(cuid())
  trackingCode         String              @unique
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  // اطلاعات کالا
  deviceType           String
  brand                String
  model                String
  description          String
  images               String[]
  videos               String[]            @default([])

  // وضعیت و فرایند
  status               RepairRequestStatus @default(PENDING_REVIEW)
  rejectionReason      String?

  // slots ارسالی ادمین + انتخاب کاربر
  availableSlots       Json?               // [{date: "2026-05-01", from: "10:00", to: "13:00"}, ...]
  adminNote            String?             // توضیحات ادمین هنگام تایید
  selectedDeliveryTime DateTime?

  // ارسال کاربر به طبقه
  shippingTrackingCode String?
  shippingVideo        String?

  // کارشناسی و نتیجه
  inspectionResult     String?             // توضیحات نتیجه بررسی
  estimatedCost        Decimal?            // هزینه برآوردی تعمیر
  userCostApproved     Boolean?            // آیا کاربر با هزینه موافقت کرد

  // ارسال برگشت طبقه به کاربر
  returnTrackingCode   String?
  returnVideo          String?
  returnConfirmDeadline DateTime?

  tickets              Ticket[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([userId])
  @@index([status])
}

model ProductRequest {
  id           String                   @id @default(cuid())
  trackingCode String                   @unique
  userId       String
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  title        String
  brand        String?
  model        String?
  condition    ProductRequestCondition?
  budgetMin    Decimal?
  budgetMax    Decimal?
  quantity     Int?                     @default(1)
  description  String
  images       String[]                 @default([])
  status       ProductRequestStatus     @default(PENDING)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([userId])
  @@index([status])
  @@index([categoryId])
  @@index([createdAt])
}

model Ticket {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repairRequestId String?
  repairRequest   RepairRequest?  @relation(fields: [repairRequestId], references: [id], onDelete: SetNull)
  subject         String
  status          TicketStatus    @default(OPEN)
  messages        TicketMessage[]
  createdAt       DateTime        @default(now())
  lastMessageAt   DateTime        @default(now())

  @@index([userId])
  @@index([repairRequestId])
  @@index([lastMessageAt])
}

model TicketMessage {
  id          String   @id @default(cuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole  UserRole
  message     String
  attachments Json?
  createdAt   DateTime @default(now())

  @@index([ticketId, createdAt])
}

////////////////////
/// IDEMPOTENCY
////////////////////

model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  endpoint  String
  response  Json?
  createdAt DateTime @default(now())

  @@index([userId, endpoint])
}

model Category {
  id        String     @id @default(cuid())
  title     String
  slug      String     @unique
  icon      String?
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  listings  Listing[]
  productRequests ProductRequest[]
  feeRules  FeeRule[]
  verificationFeeRules VerificationFeeRule[]
  userFees  UserCategoryFee[]
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())

  // Legacy generic fee (kept for backwards compat; new code uses type-specific below)
  feePercentage Float   @default(5.0)
  feeCap        Decimal @default(500000)
  feeFloor      Decimal @default(0)

  // Direct-sale commission (legacy single value; synced from New for compat)
  feePercentageDirect Float   @default(5.0)
  feeCapDirect        Decimal @default(10000000)
  feeFloorDirect      Decimal @default(0)

  // Auction commission (legacy single value; synced from New for compat)
  feePercentageAuction Float   @default(5.0)
  feeCapAuction        Decimal @default(500000)
  feeFloorAuction      Decimal @default(0)

  // Auction deposit % (legacy single value; synced from New for compat)
  auctionDepositPercent Float  @default(10.0)

  // Condition-specific percentages (NEW / USED)
  feePercentageDirectNew  Float @default(5.0)
  feePercentageDirectUsed Float @default(5.0)
  feePercentageAuctionNew  Float @default(5.0)
  feePercentageAuctionUsed Float @default(5.0)
  auctionDepositPercentNew  Float @default(10.0)
  auctionDepositPercentUsed Float @default(10.0)

  /// If false, neither seller nor buyer can opt into hub verification for this category
  verificationEnabled Boolean @default(true)

  @@index([isActive])
}

/** Override کارمزد/ودیعه هر کاربر به ازای هر دسته — null = استفاده از پیش‌فرض دسته */
model UserCategoryFee {
  id        String   @id @default(cuid())
  userId    String
  categoryId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  feePercentageDirectNew   Float?
  feePercentageDirectUsed  Float?
  feePercentageAuctionNew  Float?
  feePercentageAuctionUsed Float?
  auctionDepositPercentNew  Float?
  auctionDepositPercentUsed Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, categoryId])
  @@index([categoryId])
}

model Location {
  id               String       @id @default(cuid())
  name             String
  slug             String       @unique
  type             LocationType
  parentId         String?
  parent           Location?    @relation("LocationTree", fields: [parentId], references: [id])
  children         Location[]   @relation("LocationTree")

  provinceListings Listing[]    @relation("ProvinceListings")
  cityListings     Listing[]    @relation("CityListings")

  createdAt        DateTime     @default(now())
}

////////////////////
/// CHAT SYSTEM
////////////////////

model Conversation {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User      @relation("BuyerConversations", fields: [buyerId], references: [id])
  sellerId  String
  seller    User      @relation("SellerConversations", fields: [sellerId], references: [id])
  messages  Message[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([listingId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([conversationId, isRead, senderId])
}

////////////////////
/// ORDER & FINANCE
////////////////////

model Order {
  id                String      @id @default(cuid())
  listingId         String
  listing           Listing     @relation(fields: [listingId], references: [id])
  reviews           Review[]
  postPurchaseSurveys PostPurchaseSurvey[]

// کدهای رهگیری ارسال شده از سمت انبار طبقه به کاربران
  hubToBuyerTrackingCode  String?
  hubToSellerTrackingCode String?

  // وضعیت تایید دریافت توسط طرفین (چون تو معاوضه هر دو باید تایید کنن)
  buyerConfirmedDelivery  Boolean @default(false)
  sellerConfirmedDelivery Boolean @default(false)

  buyerId           String
  buyer             User        @relation("BuyerOrders", fields: [buyerId], references: [id])

paymentMethod    PaymentMethod @default(GATEWAY)

  sellerId          String
  seller            User        @relation("SellerOrders", fields: [sellerId], references: [id])

  type              OrderType
  /** تعداد خریداری‌شده در فروش مستقیم */
  quantity          Int         @default(1)

  // --- بخش مالی و کمیسیون ---
  finalPrice        Decimal
  shippingCost      Decimal     @default(0)
  totalAmount       Decimal
  platformFee       Decimal     @default(0)
  sellerRevenue     Decimal

  exchangeOfferId   String?

  // --- اطلاعات ارسال به خریدار ---
  shippingAddress    String?
  shippingPostalCode String?
  shippingPhone      String?
  trackingCode       String?

  // --- اطلاعات ارسال به فروشنده (مخصوص معاوضه) ---
  sellerShippingAddress    String?
  sellerShippingPostalCode String?
  sellerShippingPhone      String?
  sellerTrackingCode       String?

  // --- کارشناسی فنی (جدید) ---
  requiresVerification Boolean  @default(false) // آیا خریدار تاییدیه فنی خواسته؟
  verificationFee      Decimal  @default(0)     // مبلغ کارشناسی در زمان ثبت سفارش
  platformAddress      String?  // اسنپ‌شات آدرس طبقه در لحظه سفارش

  status            OrderStatus @default(PENDING)
  /** زمان نهایی‌شدن سفارش (برای نگهداری موقت ویدیوها) */
  completedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  /** معاوضه: نتیجه کارشناسی جداگانه هر کالا در هاب (JSON) */
  exchangeHubInspection Json?

  shippingDeadline  DateTime? // مهلت ارسال کالا
  /** پایان مهلت تایید دریافت / ثبت شکایت پس از ارسال به خریدار */
  buyerConfirmDeadline DateTime?
  cancelReason      String?   // دلیل لغو (اگر خودکار لغو شد)

  // --- مستندات تصویری (جدید) ---
  packagingVideo       String?   // ویدیوی بسته‌بندی فروشنده هنگام ارسال
  buyerPackagingVideo  String?   // ویدیوی بسته‌بندی خریدار در معاوضه (هنگام ارسال کالای خود به هاب)
  unboxingVideo        String?   // ویدیوی بازگشایی خریدار در زمان اعلام مغایرت
  sellerUnboxingVideo  String?   // ویدیوی بازگشایی فروشنده در معاوضه (هنگام دریافت کالای طرف مقابل)

  // --- مدیریت شکایت/اختلاف ---
  disputeReason        String?   // متن شکایت خریدار
  disputedAt           DateTime? // زمان ثبت شکایت
  disputeResolution    String?   // توضیح ادمین در زمان حل شکایت
  disputeResolvedAt    DateTime? // زمان حل شکایت
  disputeResolvedBy    String?   // آی‌دی ادمین حل‌کننده
  disputeOutcome       DisputeOutcome? // نتیجه (سود به خریدار/فروشنده/تقسیم/بدون)
  /** مبلغ بازگشتی به خریدار در مصالحه جزئی شکایت (PARTIAL_REFUND) — تومان */
  disputePartialRefundToBuyer Decimal?

  // --- مرجوعی پس از اختلاف ---
  returnTrackingCode   String?   // کد رهگیری مرجوعی که خریدار ثبت می‌کند
  returnPackagingVideo String?   // ویدیوی بسته‌بندی مرجوعی خریدار
  returnShippedAt      DateTime? // زمان ثبت مرجوعی توسط خریدار
  /** پایان مهلت تایید دریافت مرجوعی توسط فروشنده */
  returnConfirmDeadline DateTime?
  returnConfirmedAt    DateTime? // زمان تایید دریافت مرجوعی
  returnConfirmedBy    String?   // شناسه ادمینی که مرجوعی را تایید کرده

  /** یک‌بار: اعمال امتیاز معامله (موفق +۰.۷ یا شکست/مرجوعی −۱.۵) */
  tradeReputationAt    DateTime?

  checkoutSessionId    String?
  checkoutSession      CheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  couponRedemptions    CouponRedemption[]
  referralReward       ReferralReward?

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, disputedAt])
  @@index([listingId, createdAt])
}

/** پاداش یک‌باره معرف به‌ازای هر سفارش تکمیل‌شده فروشنده دعوت‌شده */
model ReferralReward {
  id           String   @id @default(cuid())
  orderId      String   @unique
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  referrerId   String
  referrer     User     @relation("ReferralRewardReferrer", fields: [referrerId], references: [id], onDelete: Cascade)
  sellerId     String
  seller       User     @relation("ReferralRewardSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  platformFee  Decimal
  percent      Float
  amount       Decimal
  createdAt    DateTime @default(now())

  @@index([referrerId, createdAt])
  @@index([sellerId])
}

enum DisputeOutcome {
  REFUND_BUYER      // بازگشت کامل به خریدار
  RELEASE_SELLER    // آزاد کردن کامل برای فروشنده
  PARTIAL_REFUND    // تقسیم/بازگشت جزئی
  CANCEL            // لغو بدون تسویه خاص
}

// 👈 جدول تنظیمات سیستم برای ادمین
model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

/// کلیدهای integration سرور — مقادیر رمزنگاری‌شده (AES-256-GCM) و مدیریت از پنل ادمین
model SystemSecret {
  id             String   @id @default(cuid())
  key            String   @unique
  encryptedValue String   @db.Text
  updatedById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([updatedAt])
}

model FeeRule {
  id          String      @id @default(cuid())
  listingType ListingType
  categoryId  String?
  minPrice    Decimal     @default(0)
  maxPrice    Decimal?
  feePercent  Float       @default(0)
  feeFixed    Decimal     @default(0)
  feeCap      Decimal?    // سقف نهایی کارمزد
  isActive    Boolean     @default(true)
auctionDepositPercent Float    @default(5.0)
  category    Category?   @relation(fields: [categoryId], references: [id])

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([listingType, categoryId, isActive])
}

enum VerificationFeeMode {
  FIXED
  PERCENT
}

/// قوانین پویای هزینه کارشناسی — ثابت یا درصد، با سقف و رنج قیمت / دسته
model VerificationFeeRule {
  id         String              @id @default(cuid())
  categoryId String?             // null = سراسری
  minPrice   Decimal             @default(0)
  maxPrice   Decimal?            // null = بدون سقف رنج
  mode       VerificationFeeMode
  feeValue   Decimal             // تومان یا درصد (بر اساس mode)
  feeFloor   Decimal?            // کف مبلغ نهایی کارشناسی (فقط PERCENT)
  feeCap     Decimal?            // سقف مبلغ نهایی کارشناسی
  isActive   Boolean             @default(true)
  category   Category?           @relation(fields: [categoryId], references: [id])

  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([categoryId, isActive, minPrice])
}

model Review {
  id          String   @id @default(cuid())
  orderId     String
  reviewerId  String
  revieweeId  String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  order       Order    @relation(fields: [orderId], references: [id])
  reviewer    User     @relation("GivenReviews", fields: [reviewerId], references: [id])
  reviewee    User     @relation("ReceivedReviews", fields: [revieweeId], references: [id])

  @@unique([orderId, reviewerId])
}

/// نظرسنجی رضایت پلتفرم پس از تکمیل معامله (جدا از Review طرف مقابل)
model PostPurchaseSurvey {
  id              String     @id @default(cuid())
  orderId         String
  userId          String
  role            SurveyRole
  token           String     @unique
  score           Int?
  comment         String?
  scheduledSendAt DateTime
  sentAt          DateTime?
  respondedAt     DateTime?
  openedAt        DateTime?
  expiresAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orderId, role])
  @@index([scheduledSendAt, sentAt])
  @@index([userId])
  @@index([respondedAt])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

/// IP/CIDR allowlist for Gitea (git.tabagheh.com) — synced to nginx snippet by admin API.
model GiteaIpAllowlistEntry {
  id        String   @id @default(cuid())
  name      String
  ipCidr    String
  enabled   Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ipCidr])
  @@index([enabled])
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  outline     String?
  note        String?
  image       String?
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, createdAt])
}

model LandingPage {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String?
  isPublished Boolean  @default(false)
  sections    Json     @default("[]")
  meta        Json?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, slug])
}

////////////////////
/// CAMPAIGN LINK TRACKING
////////////////////

model CampaignLink {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  targetUrl   String
  description String?
  isActive    Boolean    @default(true)
  /** Links in the same group share traffic for A/B — entry slug still unique */
  splitGroup  String?
  splitWeight Int        @default(100)

  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)

  clickLogs   ClickLog[]

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, slug])
  @@index([splitGroup, isActive])
}

model ClickLog {
  id             String       @id @default(cuid())
  campaignLinkId String
  campaignLink   CampaignLink @relation(fields: [campaignLinkId], references: [id], onDelete: Cascade)

  ipAddress   String?
  userAgent   String?
  queryParams Json?
  clickedAt   DateTime @default(now())

  @@index([campaignLinkId, clickedAt])
}

////////////////////
/// WORDPRESS INTEGRATION
////////////////////

model WordPressApiToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String    @default("default")
  tokenHash   String
  tokenPrefix String
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?
  lastUsedAt  DateTime?

  @@index([userId, revokedAt])
  @@index([tokenPrefix])
}

model WordPressConnection {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteUrl       String?
  pluginVersion String?
  catalogSecret String?
  lastPingAt    DateTime?
  lastSyncAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

////////////////////
/// CART & CHECKOUT
////////////////////

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sellerId  String
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([sellerId])
}

model CartItem {
  id               String         @id @default(cuid())
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  listingId        String
  quantity         Int            @default(1)
  /** رزرو ناشی از پیشنهاد خرید تأییدشده */
  purchaseOfferId  String?        @unique
  purchaseOffer    PurchaseOffer? @relation(fields: [purchaseOfferId], references: [id], onDelete: SetNull)
  lockedUnitPrice  Decimal?
  reservedUntil    DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([cartId, listingId])
  @@index([listingId])
  @@index([reservedUntil])
}

enum CheckoutSessionStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum CheckoutSessionSource {
  CART
  DIRECT
}

model CheckoutSession {
  id               String                @id @default(cuid())
  buyerId          String
  buyer            User                  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  totalAmount      Decimal
  discountAmount   Decimal               @default(0)
  couponId         String?
  coupon           Coupon?               @relation(fields: [couponId], references: [id], onDelete: SetNull)
  status           CheckoutSessionStatus @default(PENDING)
  /** CART = از سبد، DIRECT = خرید تکی یکپارچه */
  source           CheckoutSessionSource @default(CART)
  paymentAuthority String?
  orders           Order[]
  redemptions      CouponRedemption[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([buyerId, status])
  @@index([paymentAuthority])
}

////////////////////
/// LISTING ANALYTICS
////////////////////

model ListingView {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId String?
  viewedAt  DateTime @default(now())

  @@index([listingId, viewedAt])
  @@index([userId, viewedAt])
  @@index([sessionId, listingId, viewedAt])
}

////////////////////
/// COUPONS
////////////////////

enum CouponDiscountType {
  FIXED
  PERCENT
}

enum CouponScopeMode {
  ALL
  INCLUDE
  EXCLUDE
}

model Coupon {
  id                 String             @id @default(cuid())
  code               String             @unique
  isActive           Boolean            @default(true)
  startsAt           DateTime?
  expiresAt          DateTime?
  discountType       CouponDiscountType
  discountValue      Decimal
  maxDiscountAmount  Decimal?
  minOrderAmount     Decimal?
  maxUsesTotal       Int?
  maxUsesPerUser     Int?
  allowOnSaleItems   Boolean            @default(true)
  scopeMode          CouponScopeMode    @default(ALL)
  categoryIds        String[]           @default([])
  listingIds         String[]           @default([])
  /** محصولات مستثنی از تخفیف (حتی اگر در دسته/محدوده باشند) */
  excludedListingIds String[]           @default([])
  userIds            String[]           @default([])
  /** مالک فروشنده — null یعنی کوپن سراسری ادمین */
  sellerId           String?
  seller             User?              @relation("SellerCoupons", fields: [sellerId], references: [id], onDelete: Cascade)
  usedCount          Int                @default(0)
  checkoutSessions   CheckoutSession[]
  redemptions        CouponRedemption[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([isActive, code])
  @@index([sellerId, createdAt])
}

model CouponRedemption {
  id                String           @id @default(cuid())
  couponId          String
  coupon            Coupon           @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId           String?
  order             Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  checkoutSessionId String?
  checkoutSession   CheckoutSession? @relation(fields: [checkoutSessionId], references: [id], onDelete: SetNull)
  amount            Decimal
  createdAt         DateTime         @default(now())

  @@index([couponId, userId])
  @@index([checkoutSessionId])
}

////////////////////
/// MARKETING / SOCIAL
////////////////////

enum MarketingPlatform {
  INSTAGRAM
}

enum MarketingAccountStatus {
  ACTIVE
  TOKEN_EXPIRED
  REVOKED
  ERROR
}

enum MarketingPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

enum MarketingMediaType {
  IMAGE
  VIDEO
  CAROUSEL
  REEL
  STORY
}

enum MarketingMessageDirection {
  IN
  OUT
}

model MarketingAccount {
  id             String                 @id @default(cuid())
  platform       MarketingPlatform
  externalId     String
  username       String
  displayName    String?
  profilePicture String?
  status         MarketingAccountStatus @default(ACTIVE)
  lastError      String?
  connectedById  String
  connectedBy    User                   @relation(fields: [connectedById], references: [id], onDelete: Cascade)
  token          MarketingAccountToken?
  mediaAssets    MarketingMediaAsset[]
  posts          MarketingPost[]
  conversations  MarketingConversation[]
  insightSnapshots MarketingInsightSnapshot[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([platform, externalId])
  @@index([platform, status])
  @@index([connectedById])
}

model MarketingAccountToken {
  id              String           @id @default(cuid())
  accountId       String           @unique
  account         MarketingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accessTokenEnc  String
  tokenExpiresAt  DateTime?
  scopes          String[]
  lastRefreshedAt DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model MarketingMediaAsset {
  id           String              @id @default(cuid())
  accountId    String?
  account      MarketingAccount?   @relation(fields: [accountId], references: [id], onDelete: SetNull)
  fileName     String
  mimeType     String
  localPath    String
  publicUrl    String
  mediaType    MarketingMediaType  @default(IMAGE)
  caption      String?
  altText      String?
  width        Int?
  height       Int?
  durationSec  Float?
  fileSize     Int?
  createdById  String
  createdBy    User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  posts        MarketingPost[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([accountId, createdAt])
  @@index([createdById])
}

model MarketingPost {
  id              String              @id @default(cuid())
  accountId       String
  account         MarketingAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  mediaAssetId    String?
  mediaAsset      MarketingMediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)
  /** IDs of additional media assets for carousel */
  mediaAssetIds   String[]            @default([])
  platformMediaId String?
  containerId     String?
  mediaType       MarketingMediaType
  caption         String?
  status          MarketingPostStatus @default(DRAFT)
  scheduledAt     DateTime?
  publishedAt     DateTime?
  errorMessage    String?
  createdById     String
  createdBy       User                @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([accountId, status])
  @@index([status, scheduledAt])
  @@index([createdById])
}

model MarketingConversation {
  id                 String            @id @default(cuid())
  accountId          String
  account            MarketingAccount  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  externalThreadId   String
  participantName    String?
  participantAvatar  String?
  lastMessageAt      DateTime?
  unreadCount        Int               @default(0)
  messages           MarketingMessage[]
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@unique([accountId, externalThreadId])
  @@index([accountId, lastMessageAt])
}

model MarketingMessage {
  id                String                    @id @default(cuid())
  conversationId    String
  conversation      MarketingConversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalMessageId String?
  direction         MarketingMessageDirection
  text              String?
  attachments       Json?
  sentAt            DateTime                  @default(now())
  sentByAdminId     String?
  sentByAdmin       User?                     @relation(fields: [sentByAdminId], references: [id], onDelete: SetNull)

  @@unique([conversationId, externalMessageId])
  @@index([conversationId, sentAt])
}

model MarketingInsightSnapshot {
  id         String           @id @default(cuid())
  accountId  String
  account    MarketingAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  metricKey  String
  value      Float
  period     String           @default("day")
  capturedAt DateTime         @default(now())

  @@index([accountId, metricKey, capturedAt])
  @@index([accountId, capturedAt])
}