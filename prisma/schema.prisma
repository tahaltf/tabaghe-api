generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////
/// ENUMS
////////////////////

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  INCOMPLETE
  PENDING
  APPROVED
  REJECTED
}

enum ListingType {
  DIRECT
  EXCHANGE
  AUCTION
}

enum ListingStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  DELETED_BY_USER
  SOLD
}

enum ItemCondition {
  NEW
  USED
}

enum ShippingPayer {
  SELLER
  BUYER_PREPAID
  CASH_ON_DELIVERY
}

enum QuotaReason {
  FREE_DIRECT
  PLAN
}

enum QuotaAction {
  RESERVE
  COMMIT
  RELEASE
}

enum WalletTransactionType {
  DEPOSIT
  BLOCK
  UNBLOCK
  SETTLEMENT
  PENALTY
  WITHDRAW_REQUEST
  WITHDRAW_PAID
}

enum WalletTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum AuctionStatus {
  ACTIVE
  FINISHED
}

enum AuctionSettlementStatus {
  PENDING
  PAID
  FAILED
  PENALIZED
}

enum AuctionBidStatus {
  ACTIVE
  OUTBID
  WON
  LOST
  CANCELLED
}

enum ExchangeOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

enum NotificationType {
  AUCTION_WON
  AUCTION_LOST
  AUCTION_PAYMENT_REMINDER
  AUCTION_PENALIZED
  BUY_NOW
  EXCHANGE_OFFER_RECEIVED
  EXCHANGE_OFFER_ACCEPTED
  EXCHANGE_OFFER_REJECTED
}

enum RepairRequestStatus {
  PENDING_REVIEW
  REJECTED
  APPROVED
  DELIVERY_TIME_SELECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

enum OtpPurpose {
  LOGIN
  REGISTER
}

////////////////////
/// USER
////////////////////

model User {
  id                String     @id @default(cuid())
  phone             String     @unique
  email             String?    @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  nationalCode      String?    @unique
  nationalCardImage String?
  status            UserStatus @default(INCOMPLETE)
  role              UserRole   @default(USER)

  // ✅ فیلدهای اضافه شده برای صفحه تنظیمات
  avatar            String?    // عکس پروفایل
  bio               String?    // بیوگرافی یا درباره من
  notifyEmail       Boolean    @default(true)
  notifySms         Boolean    @default(false)
  notifyPush        Boolean    @default(true)
  lastLoginAt       DateTime?

  listings       Listing[]
  wallet         Wallet?
  planPurchases  UserPlanPurchase[]
  quotaLedger    QuotaLedger[]
  notifications  Notification[]
  exchangeOffers ExchangeOffer[]
  bids           AuctionBid[]

  highestBids ListingAuction[] @relation("HighestBidder")
  secondBids  ListingAuction[] @relation("SecondBidder")
  thirdBids   ListingAuction[] @relation("ThirdBidder")

  repairRequests RepairRequest[]
  tickets        Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

////////////////////
/// AUTH & OTP
////////////////////

model OtpCode {
  id        String     @id @default(cuid())
  phone     String
  code      String
  purpose   OtpPurpose @default(LOGIN)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([phone])
}

////////////////////
/// WALLET
////////////////////

model Wallet {
  id               String  @id @default(cuid())
  userId           String  @unique
  balanceAvailable Decimal @default(0)
  balanceBlocked   Decimal @default(0)
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions     WalletTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WalletTransaction {
  id          String                  @id @default(cuid())
  walletId    String
  wallet      Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        WalletTransactionType
  amount      Decimal
  status      WalletTransactionStatus
  referenceId String?
  meta        Json?
  createdAt   DateTime                @default(now())
}

////////////////////
/// LISTING
////////////////////

model Listing {
  id              String        @id @default(cuid())
  authorId        String
  author          User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  type            ListingType
  status          ListingStatus @default(PENDING)
  title           String
  categoryId      String
  gallery         String[]      @default([])
  thumbnail       String?
  condition       ItemCondition
  description     String
  province        String
  city            String
  shippingPayer   ShippingPayer @default(BUYER_PREPAID)
  rejectionReason String?
  deleteReason    String?
  approvedAt      DateTime?
  rejectedAt      DateTime?
  deletedAt       DateTime?

  direct         ListingDirect?
  exchange       ListingExchange?
  auction        ListingAuction?
  quotaLedger    QuotaLedger[]
  exchangeOffers ExchangeOffer[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, type])
  @@index([authorId])
  @@index([province, city])
  @@index([createdAt])
}

model ListingDirect {
  listingId       String   @id
  listing         Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  price           Decimal
  allowExchange   Boolean  @default(false)
  shippingMethods String[]
}

model ListingExchange {
  listingId          String   @id
  listing            Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  desiredCategoryId  String
  desiredTitle       String
  desiredDescription String?
  ownValue           Decimal
  extraPaymentAmount Decimal  @default(0)
  acceptOtherItems   Boolean  @default(false)
  allowDirectSale    Boolean  @default(false)
  directPrice        Decimal?
}

model ListingAuction {
  listingId       String        @id
  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  basePrice       Decimal
  minBidIncrement Decimal
  endDatetime     DateTime
  buyNowEnabled   Boolean       @default(false)
  buyNowPrice     Decimal?
  status          AuctionStatus @default(ACTIVE)

  highestBidAmount Decimal?
  highestBidderId  String?
  highestBidder    User?    @relation("HighestBidder", fields: [highestBidderId], references: [id], onDelete: SetNull)

  secondBidderId String?
  secondBidder   User?   @relation("SecondBidder", fields: [secondBidderId], references: [id], onDelete: SetNull)

  thirdBidderId String?
  thirdBidder   User?   @relation("ThirdBidder", fields: [thirdBidderId], references: [id], onDelete: SetNull)

  bids            AuctionBid[]
  settlementStatus AuctionSettlementStatus @default(PENDING)
  paymentDeadline DateTime?
  finishedAt      DateTime?

  @@index([status, endDatetime])
}

model AuctionBid {
  id            String           @id @default(cuid())
  listingId     String
  auction       ListingAuction   @relation(fields: [listingId], references: [listingId], onDelete: Cascade)
  bidderId      String
  bidder        User             @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  amount        Decimal
  blockedAmount Decimal          @default(0)
  status        AuctionBidStatus @default(ACTIVE)
  createdAt     DateTime         @default(now())

  @@index([listingId, createdAt])
  @@index([bidderId, createdAt])
}

////////////////////
/// PLANS & QUOTA
////////////////////

model Plan {
  id          String             @id @default(cuid())
  title       String
  description String?
  price       Int                @default(0)
  isActive    Boolean            @default(true)
  rules       PlanRule[]
  purchases   UserPlanPurchase[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model PlanRule {
  id     String      @id @default(cuid())
  planId String
  plan   Plan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  type   ListingType
  count  Int

  @@unique([planId, type])
}

model UserPlanPurchase {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        Plan          @relation(fields: [planId], references: [id])
  status      String        @default("ACTIVE")
  quotaLedger QuotaLedger[]
  createdAt   DateTime      @default(now())
}

model QuotaLedger {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId      String?
  listing        Listing?          @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingType    ListingType
  action         QuotaAction
  reason         QuotaReason
  planPurchaseId String?
  planPurchase   UserPlanPurchase? @relation(fields: [planPurchaseId], references: [id], onDelete: SetNull)
  note           String?
  createdAt      DateTime          @default(now())

  @@index([userId, listingType])
}

////////////////////
/// NOTIFICATION
////////////////////

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  meta      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

////////////////////
/// EXCHANGE
////////////////////

model ExchangeOffer {
  id           String              @id @default(cuid())
  listingId    String
  listing      Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  offererId    String
  offerer      User                @relation(fields: [offererId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  images       String[]
  extraPayment Decimal             @default(0)
  status       ExchangeOfferStatus @default(PENDING)
  createdAt    DateTime            @default(now())

  @@index([listingId, status])
  @@index([offererId])
}

////////////////////
/// REPAIR & TICKET
////////////////////

model RepairRequest {
  id                   String              @id @default(cuid())
  trackingCode         String              @unique
  userId               String
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType           String
  brand                String
  model                String
  description          String
  images               String[]
  status               RepairRequestStatus @default(PENDING_REVIEW)
  rejectionReason      String?
  selectedDeliveryTime DateTime?
  tickets              Ticket[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([userId])
  @@index([status])
}

model Ticket {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  repairRequestId String?
  repairRequest   RepairRequest?  @relation(fields: [repairRequestId], references: [id], onDelete: SetNull)
  subject         String
  status          TicketStatus    @default(OPEN)
  messages        TicketMessage[]
  createdAt       DateTime        @default(now())

  @@index([userId])
  @@index([repairRequestId])
}

model TicketMessage {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderRole UserRole
  message    String
  createdAt  DateTime @default(now())

  @@index([ticketId, createdAt])
}

////////////////////
/// IDEMPOTENCY
////////////////////

model IdempotencyKey {
  id        String   @id @default(cuid())
  key       String   @unique
  userId    String
  endpoint  String
  response  Json?
  createdAt DateTime @default(now())

  @@index([userId, endpoint])
}