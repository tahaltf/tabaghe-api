# نمونه برای سرور پروداکشن — کپی کن به .env.production روی سرور (در گیت نیست)
# قبل از اجرا حتماً NODE_ENV=production را در محیط پروسه ست کن (Docker، PM2، systemd)
# چون بارگذاری env بر اساس NODE_ENV است؛ بدون آن ممکن است پیش‌فرض development خوانده شود.

API_URL=https://api.tabagheh.com
FRONTEND_APP_URL=https://tabagheh.com
PAYMENT_RETURN_URL=https://tabagheh.com/payment-result
FRONTEND_ORIGINS=https://tabagheh.com,https://www.tabagheh.com

ACTIVE_PAYMENT_GATEWAY=zibal
ZIBAL_MERCHANT=your-merchant-id
ZIBAL_REQUEST_URL=https://gateway.zibal.ir/v1/request
ZIBAL_VERIFY_URL=https://gateway.zibal.ir/v1/verify
ZIBAL_START_PAY_URL=https://gateway.zibal.ir/start
ZIBAL_CALLBACK_URL=https://api.tabagheh.com/api/v1/payments/callback/zibal
# اگر سرور ENOTFOUND برای gateway.zibal.ir می‌دهد: روی همان سرور DNS را چک کنید
# (nslookup gateway.zibal.ir، یا DNS عمومی مثل 8.8.8.8 در resolv.conf / Docker --dns).
# خروجی HTTPS به این دامنه باید از خود سرور API باز باشد.

DATABASE_URL=postgresql://user:pass@host:5432/db
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=43200
ACTIVE_SMS_PROVIDER=smsir
SMS_IR_API_KEY=
KAVENEGAR_API_KEY=
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@tabagheh.com

PORT=3000

# Marketing / Instagram (Meta Developer App)
API_PUBLIC_URL=https://api.tabagheh.com
MARKETING_OAUTH_REDIRECT_URI=https://api.tabagheh.com/api/v1/integrations/marketing/instagram/oauth/callback
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
MARKETING_TOKEN_ENC_KEY=
ADMIN_SECRETS_ENC_KEY=

# AI Content Studio (Liara)
LIARA_API_KEY=
LIARA_BASE_URL=https://ai.liara.ir/api/6a787a10332d5f922cf9083c/v1

# ── Gitea IP allowlist (git.tabagheh.com via nginx) ──
# API بعد از افزودن/حذف IP فایل را می‌نویسد و nginx را reload می‌کند تا فوری اعمال شود.
# مسیر باید همان فایلی باشد که در vhost گیت include شده:
# GITEA_IP_ALLOWLIST_FILE=/etc/nginx/snippets/gitea-ip-allowlist.conf
# GITEA_IP_FORBIDDEN_HTML=/var/www/gitea-forbidden/gitea-ip-forbidden.html
# GITEA_IP_ALLOWLIST_ALWAYS=127.0.0.1,::1
# پیش‌فرض: چند دستور reload امن را امتحان می‌کند. برای دستور صریح:
# GITEA_IP_ALLOWLIST_RELOAD_CMD=sudo -n nginx -t && sudo -n nginx -s reload
# برای خاموش کردن auto-reload: GITEA_IP_ALLOWLIST_AUTO_RELOAD=0
# sudoers نمونه برای کاربر API:
#   tabagheh-api ALL=(root) NOPASSWD: /usr/sbin/nginx -t, /usr/sbin/nginx -s reload

# ── Crawler IP allowlist (crawler.tabagheh.com via nginx) ──
# CRAWLER_IP_ALLOWLIST_FILE=/etc/nginx/snippets/crawler-ip-allowlist.conf
# CRAWLER_IP_FORBIDDEN_HTML=/var/www/crawler-forbidden/crawler-ip-forbidden.html
# CRAWLER_IP_ALLOWLIST_ALWAYS=127.0.0.1,::1
# CRAWLER_IP_ALLOWLIST_RELOAD_CMD=sudo -n nginx -t && sudo -n nginx -s reload
# CRAWLER_IP_ALLOWLIST_AUTO_RELOAD=1
# Same value must be set on crawler container for /gate login verify
# CRAWLER_GATE_SHARED_SECRET=
# Live Divar → Seller CRM lead ingest (same secret on crawler)
# SELLER_CRM_INGEST_SECRET=
# Optional admin User id for auto leads (falls back to oldest ADMIN)
# SELLER_CRM_CRAWLER_ADMIN_ID=
