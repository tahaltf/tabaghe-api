DATABASE_URL="postgresql://user:password@localhost:5432/tabagheh"

JWT_SECRET="replace-with-strong-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

SMS_IR_API_KEY="replace-with-sms-ir-api-key"

# Zibal payment gateway
ACTIVE_PAYMENT_GATEWAY="zibal"
ZIBAL_MERCHANT="replace-with-zibal-merchant"
ZIBAL_REQUEST_URL="https://gateway.zibal.ir/v1/request"
ZIBAL_START_PAY_URL="https://gateway.zibal.ir/start"
ZIBAL_CALLBACK_URL="https://api.tabagheh.com/api/v1/payments/callback/zibal"
API_URL="https://api.tabagheh.com"
FRONTEND_APP_URL="https://app.tabagheh.com"
PAYMENT_RETURN_URL="https://app.tabagheh.com/payment-result"

# Comma-separated list of allowed frontend origins for CORS
FRONTEND_ORIGINS="https://app.tabagheh.com,http://localhost:4200"

# Optional
PORT=3000
