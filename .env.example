# کپی کن به نام `.env` و رازها را پر کن.
# بارگذاری ترتیبی (آخرین کلید برنده است):
#   NODE_ENV=development → `.env.development` سپس `.env.development.local` سپس `.env`
#   NODE_ENV=production  → `.env.production` سپس `.env.production.local` سپس `.env`
#
# لوکال: از `npm run start:dev` استفاده کن (NODE_ENV پیش‌فرض development است).
# پروداکشن: قبل از اجرا حتماً NODE_ENV=production ست کن؛ نمونهٔ متغیرها: `.env.production.example`

DATABASE_URL="postgresql://user:password@localhost:5432/tabagheh"

JWT_SECRET="replace-with-strong-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

SMS_IR_API_KEY="replace-with-sms-ir-api-key"
WEB_PUSH_VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
WEB_PUSH_VAPID_PRIVATE_KEY="replace-with-vapid-private-key-pem"
WEB_PUSH_VAPID_SUBJECT="mailto:support@example.com"

# بقیه (درگاه، API_URL، ...) را در `.env.development` یا `.env.production` بگذار نه اینجا،
# مگر اینکه بخواهی چیزی را شخصی اووراید کنی.

PORT=3000
