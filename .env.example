# کپی کن به نام `.env` و رازها را پر کن.
# بارگذاری ترتیبی (آخرین کلید برنده است):
#   NODE_ENV=development → `.env.development` سپس `.env.development.local` سپس `.env`
#   NODE_ENV=production  → `.env.production` سپس `.env.production.local` سپس `.env`
#
# لوکال: از `npm run start:dev` استفاده کن (NODE_ENV پیش‌فرض development است).
# پروداکشن: قبل از اجرا حتماً NODE_ENV=production ست کن؛ نمونهٔ متغیرها: `.env.production.example`

DATABASE_URL="postgresql://user:password@localhost:5432/tabagheh"

JWT_SECRET="replace-with-strong-secret"
JWT_REFRESH_SECRET="replace-with-strong-refresh-secret"
JWT_ACCESS_TTL_SECONDS=900
# 12 hours — keep sessions short; raise only if product requires longer login
JWT_REFRESH_TTL_SECONDS=43200

SMS_IR_API_KEY="replace-with-sms-ir-api-key"

# smsir | kavenegar
ACTIVE_SMS_PROVIDER=smsir
# KAVENEGAR_API_KEY="replace-with-kavenegar-api-key"

# اختیاری — اگر در تنظیمات ادمین خالی باشد از اینجا خوانده می‌شود:
# SMS_OTP_TEMPLATE_ID=
# SMS_OTP_TEMPLATE_NAME=
# SMS_OTP_CODE_PARAMETER_NAME=CONTACTS
# SMS_ADMIN_LOGIN_ALERT_ENABLED=true
# SMS_ADMIN_LOGIN_ALERT_TEMPLATE_ID=
# SMS_ADMIN_LOGIN_ALERT_RECIPIENTS=0912xxxxxxx,0913xxxxxxx
# SMS_ADMIN_LOGIN_ALERT_USER_PHONE_PARAMETER=PHONE
# Post-deploy SMS — put in the same .env that compose loads (on server: /app/tabagheh/api/.env):
# SMS_DEPLOY_ALERT_ENABLED=1
# SMS_DEPLOY_ALERT_RECIPIENTS=0912xxxxxxx,0913xxxxxxx
# SMS_DEPLOY_ALERT_TEMPLATE_ID=          # قالب sms.ir با #STATUS و #DETAIL
# ترجیحاً همین‌ها را از پنل ادمین → تنظیمات → پیامک ورود و دیپلوی ست کنید
# (اسکریپت post-deploy از API پنل می‌خواند؛ .env فقط fallback است)
# SMS_IR_LINE_NUMBER=                    # اختیاری: اگر قالب ندارید، ارسال متنی با خط خدماتی
#
# Uptime monitor (host cron every 5 min — see scripts/uptime-monitor.sh):
# UPTIME_MONITOR_ENABLED=1
# UPTIME_FAIL_THRESHOLD=2
# SMS_UPTIME_ALERT_ENABLED=1
# SMS_UPTIME_ALERT_RECIPIENTS=
# SMS_UPTIME_ALERT_TEMPLATE_ID=          # قالب جدا — مثلاً «مانیتور طبقه: #STATUS — #DETAIL»
# crontab:
#   */5 * * * * ROOT=/app/tabagheh bash /app/tabagheh/api/scripts/uptime-monitor.sh >> /app/tabagheh/logs/uptime-monitor.log 2>&1

WEB_PUSH_VAPID_PUBLIC_KEY="replace-with-vapid-public-key-base64url"
# base64url (خروجی web-push generateVAPIDKeys) یا PEM PKCS#8 — هر دو پشتیبانی می‌شود
WEB_PUSH_VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
WEB_PUSH_VAPID_SUBJECT="mailto:support@example.com"

# بقیه (درگاه، API_URL، ...) را در `.env.development` یا `.env.production` بگذار نه اینجا،
# مگر اینکه بخواهی چیزی را شخصی اووراید کنی.
#
# آدرس سرویس خزشگر دیوار (Python FastAPI) — پیش‌فرض لوکال
# CRAWLER_SERVICE_URL=http://127.0.0.1:5050

# ── Marketing / Instagram (Meta Developer App) ──
# ساخت App: https://developers.facebook.com/ → Instagram API with Instagram Login
# Redirect URI: {API_URL}/api/v1/integrations/marketing/instagram/oauth/callback
# Webhook URL:  {API_URL}/api/v1/integrations/marketing/instagram/webhook
# META_APP_ID=
# META_APP_SECRET=
# META_WEBHOOK_VERIFY_TOKEN=replace-with-random-verify-token
# MARKETING_OAUTH_REDIRECT_URI=http://localhost:3000/api/v1/integrations/marketing/instagram/oauth/callback
# MARKETING_TOKEN_ENC_KEY=   # 64 hex chars (32 bytes) — openssl rand -hex 32
# API_PUBLIC_URL=http://localhost:3000   # برای URL عمومی رسانه (Instagram باید بتواند دانلود کند)
# ADMIN_SECRETS_ENC_KEY=   # 64 hex chars (32 bytes) — openssl rand -hex 32

# ── AI Content Studio (Liara OpenAI-compatible) ──
# docs: https://docs.liara.ir/ai/foundations/image-generation/
# LIARA_API_KEY=
# LIARA_BASE_URL=https://ai.liara.ir/api/6a787a10332d5f922cf9083c/v1
# AI_CONTENT_OPENAI_API_KEY=   # optional fallback
# OPENAI_API_KEY=              # optional fallback
# OPENAI_BASE_URL=             # optional fallback if LIARA_BASE_URL empty

PORT=3000
