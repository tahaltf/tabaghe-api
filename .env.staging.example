# ======================
# App
# ======================
NODE_ENV=development
PORT=3000

# ======================
# Database
# ======================
DATABASE_URL=postgresql://user:password@localhost:5432/tabaghe

# Staging: copy to .env.staging and set real credentials before deploy QA.
# Run: npm run db:deploy

# ======================
# Auth
# ======================
JWT_SECRET=replace-with-strong-secret
JWT_REFRESH_SECRET=replace-with-strong-refresh-secret
GODADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_PASSWORD=

# ======================
# CORS / URLs
# ======================
FRONTEND_APP_URL=http://localhost:4200
FRONTEND_ORIGINS=http://localhost:4200

# ======================
# SMS — Web OTP Android
# ======================
ACTIVE_SMS_PROVIDER=smsir
SMS_IR_API_KEY=replace-with-sms-ir-api-key
# KAVENEGAR_API_KEY=replace-with-kavenegar-api-key
# Template 591069 — last line MUST be (parameter name = CONTACTS by default):
#   @tabagheh.com #CONTACTS
# Full example body:
#   کد تایید طبقه: #CONTACTS
#   @tabagheh.com #CONTACTS
SMS_OTP_TEMPLATE_ID=591069
# SMS_OTP_TEMPLATE_NAME=myverification
SMS_OTP_CODE_PARAMETER_NAME=CONTACTS
SMS_WEB_OTP_ORIGIN=tabagheh.com
# Set true after verifying template in sms.ir production panel:
# SMS_WEB_OTP_TEMPLATE_CONFIRMED=true

# ======================
# Seller landing seed (dev auto-runs on API boot)
# ======================
# SELLER_LANDING_AUTO_SEED=true
# SELLER_LANDING_FORCE_SEED=false

# ======================
# Optional (Future)
# ======================
# Redis (required for multi-replica staging/prod — cache, throttler, Socket.io)
# REDIS_URL=redis://tabagheh-redis:6379
REDIS_URL=redis://tabagheh-redis:6379
# SENTRY_DSN=
